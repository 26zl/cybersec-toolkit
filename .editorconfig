root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{mjs,js,json,jsonc,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

# lib/distro_compat.tsv columns are tab-separated.
[*.tsv]
indent_style = tab

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false
